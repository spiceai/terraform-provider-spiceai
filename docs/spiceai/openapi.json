    "/v1/regions": {
      "get": {
        "summary": "List available deployment regions",
        "description": "Returns a list of available regions where apps can be deployed.\nRegions are filtered based on the environment (production vs development).\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "env",
            "schema": {
              "type": "string",
              "enum": ["prod", "dev"]
            },
            "description": "Filter by environment (defaults to prod in production)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of available regions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "regions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Human-readable region name"
                          },
                          "region": {
                            "type": "string",
                            "description": "Region identifier (e.g., us-east-2)"
                          },
                          "provider": {
                            "type": "string",
                            "enum": ["teraswitch", "aws", "azure"]
                          },
                          "providerName": {
                            "type": "string",
                            "enum": ["Teraswitch", "AWS", "Azure"]
                          },
                          "isDefault": {
                            "type": "boolean"
                          },
                          "disabled": {
                            "type": "boolean"
                          },
                          "cname": {
                            "type": "string",
                            "description": "CNAME for the region (e.g., us-east-2.spice.cloud)"
                          }
                        }
                      }
                    },
                    "default": {
                      "type": "string",
                      "description": "The default region identifier"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Insufficient scope"
          }
        },
        "tags": ["Regions"]
      }
    }
