  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth 2.0 access token obtained from the Spice.ai authentication service"
      }
    },
    "schemas": {
      "App": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the app"
          },
          "name": {
            "type": "string",
            "description": "Name of the app"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Description of the app"
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "private"],
            "description": "Visibility setting for the app"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the app was created"
          },
          "region": {
            "type": "string",
            "nullable": true,
            "description": "Region where the app is deployed"
          },
          "cluster_id": {
            "type": "string",
            "nullable": true,
            "description": "Cluster ID where the app is deployed"
          },
          "api_key": {
            "type": "string",
            "nullable": true,
            "description": "Primary API key for the app"
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true,
            "description": "Key-value tags for the app"
          }
        }
      },
      "AppWithConfig": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the app"
          },
          "name": {
            "type": "string",
            "description": "Name of the app"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Description of the app"
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "private"],
            "description": "Visibility setting for the app"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the app was created"
          },
          "production_branch": {
            "type": "string",
            "nullable": true,
            "description": "Production branch for the app"
          },
          "api_key": {
            "type": "string",
            "nullable": true,
            "description": "Primary API key for the app"
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true,
            "description": "Key-value tags for the app"
          },
          "config": {
            "type": "object",
            "properties": {
              "spicepod": {
                "type": "object",
                "nullable": true,
                "description": "Spicepod configuration"
              },
              "registry": {
                "type": "string",
                "nullable": true,
                "description": "Registry for the spiced image"
              },
              "image": {
                "type": "string",
                "nullable": true,
                "description": "Image name for the spiced container"
              },
              "image_tag": {
                "type": "string",
                "nullable": true,
                "description": "Spice.ai runtime image tag"
              },
              "update_channel": {
                "type": "string",
                "enum": ["stable", "nightly", "internal", "internal-sandbox"],
                "nullable": true,
                "description": "Update channel for the spicepod"
              },
              "replicas": {
                "type": "integer",
                "description": "Number of replicas"
              },
              "region": {
                "type": "string",
                "nullable": true,
                "description": "Region where the app is deployed"
              },
              "node_group": {
                "type": "string",
                "nullable": true,
                "description": "Node group for the app"
              },
              "storage_claim_size_gb": {
                "type": "number",
                "nullable": true,
                "description": "Storage claim size in GB"
              }
            }
          }
        }
      },
      "Secret": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the secret"
          },
          "name": {
            "type": "string",
            "description": "Name of the secret"
          },
          "value": {
            "type": "string",
            "description": "Always masked with asterisks"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the secret was created"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the secret was last updated"
          }
        }
      },
      "Deployment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the deployment"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "in_progress", "succeeded", "failed", "created"],
